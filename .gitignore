# --- pdf_engine generated output ------------------------------------------
# Rendered PDFs are build output, not source -- this applies both to the
# top-level output/ directory used by the local test entrypoint and to any
# PDFs a Django deployment writes under MEDIA_ROOT/crif_reports/.
output/*.pdf
*.pdf
!docs/sample_report.pdf

